# Local data / outputs (PoC) — anchored to repo root so subdirectories named
# `data/` (e.g. inside sample corpora) are not affected.
/data/
/outputs/
# Per-run generated artifacts under any sample corpus output/ dir
samples/**/output/
# Synthetic data warehouse — regenerated on demand by seed_db.py
samples/synthetic_compound/edc.sqlite
*.gdoc
*.docx
*.pdf
!docs/*.pdf
!samples/**/*.pdf
!samples/**/*.docx
!samples/**/*.xlsx

# Local vector indexes
.faiss/
*.faiss
*.index
chroma/

# Terraform (when added later)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Design-export working artifacts (not app code)
design-export/
design-export.zip

# Personal templates are not committed.
# report-templates/*.md is the shared library; users/ holds one directory per
# person. Someone's own drafts are theirs, and committing them would publish
# to the repository the thing the scope exists to keep out of the shared list.
report-templates/users/

# Configured connections are machine state, not source.
# Settings only — never a credential — but still per-machine: a DSN and a
# service name are this deployment's, not the repository's.
var/connections.json
